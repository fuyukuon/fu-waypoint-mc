{
  "name": "fu-waypoint",
  "private": true,
  "version": "2.1.2",
  "description": "fu-WAYPOINT v2.1.2 - Minecraft Waypoint Manager",
  "author": "fu WAYPOINT",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "node scripts/generate-icons.mjs && vite",
    "build": "node scripts/generate-icons.mjs && vite build",
    "preview": "vite preview",
    "capacitor:copy:after": "node scripts/generate-icons.mjs",
    "capacitor:sync:after": "node scripts/generate-icons.mjs",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && node scripts/fix-wincodesign.mjs && electron-builder --win"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.minecraft.fuwaypoint",
    "productName": "fu-WAYPOINT",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "public/icon.png",
      "verifyUpdateCodeSignature": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName}-v${version}-Portable.${ext}"
    }
  }
}
